# Copy to .env and fill in. Expo inlines EXPO_PUBLIC_* vars at build time, so
# everything here ends up in the shipped bundle. Only put public client
# identifiers in this file, never a service account key or an API secret.
#
# For EAS builds, set the same values as EAS environment variables
# (eas env:create) rather than committing a .env.

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
# The deployed API, on AWS (eu-central-1), owned by Nour. This is the one to
# build against:
#   http://ChicFi-Compu-53UqAFwIwtDd-1468854081.eu-central-1.elb.amazonaws.com
#
# It is HTTP, not HTTPS: the load balancer has no TLS listener because a
# certificate needs a domain nobody has registered yet. app.config.ts reads
# this value and adds a narrowly scoped iOS ATS exception for exactly that
# hostname, which is what lets the app reach it at all. The exception is
# generated only while this URL starts with http://, so pointing it at an
# https:// address removes the exception automatically.
#
# Apple reviews ATS exceptions. Do not submit to the App Store on an http URL.
#
# For local development against your own machine, use your computer's LAN IP
# rather than localhost, because the phone resolves localhost to itself.
EXPO_PUBLIC_API_URL=http://ChicFi-Compu-53UqAFwIwtDd-1468854081.eu-central-1.elb.amazonaws.com

# ---------------------------------------------------------------------------
# Firebase (same project as the web frontend)
# Console > Project settings > Your apps > iOS/Android app
# ---------------------------------------------------------------------------
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Google sign-in
# Google Cloud console > APIs & Services > Credentials > OAuth 2.0 Client IDs.
# Create one client per platform. The iOS client's bundle ID must match
# app.chicfinder.mobile.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# ---------------------------------------------------------------------------
# Links shown in the app. Both must be live before submitting to the App Store.
# ---------------------------------------------------------------------------
# No privacy policy is live yet. The draft is in docs/privacy-policy.md and the
# Framer site (https://chicfinder.framer.website) can host it. Apple will not
# accept a submission without a working URL here.
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://chicfinder.app/privacy
EXPO_PUBLIC_SUPPORT_EMAIL=support@chicfinder.app
