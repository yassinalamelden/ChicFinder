# API Settings
API_V1_STR=/api/v1
PROJECT_NAME=ChicFinder
APP_ENV=development

# OpenAI Settings (not used in active code — reserved for a future GPT-4o pipeline)
OPENAI_API_KEY=
GPT_MODEL=gpt-4o

# OpenRouter Settings (used by ai_engine/llm/ — OutfitParser + VisionReranker, routed to Gemini)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Firebase Settings (optional — only needed for production auth verification)
FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_CREDENTIALS_PATH=
