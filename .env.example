# ChicFinder — Backend environment variables
# ─────────────────────────────────────────────
# Copy to .env and fill in your values before running the server.
# Never commit .env to version control.

# ── Supabase (required) ───────────────────────
# PostgreSQL + pgvector for product data and vector search
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Firebase Auth (required for /api/v1/search) ───────────────────────────────
# Used to verify Firebase ID tokens sent by the frontend.
# Only FIREBASE_PROJECT_ID is needed (no service-account file required).
FIREBASE_PROJECT_ID=your-firebase-project-id

# ── Gemini AI (required for outfit parsing) ──────────────────────────────────
# Used by ai_engine/llm/outfit_parser.py (Gemini 2.5-flash).
GEMINI_API_KEY=your-gemini-api-key

# ── OpenAI (future GPT-4o pipeline) ──────────────────────────────────────────
# Not used by the current active code path — reserved for future reranking.
OPENAI_API_KEY=your-openai-key

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Production: set to your Railway frontend URL, e.g. https://chicfinder.up.railway.app
ALLOWED_ORIGINS=http://localhost:3000
