# API Settings
API_V1_STR=/api/v1
PROJECT_NAME=ChicFinder

# OpenAI Settings
OPENAI_API_KEY=
GPT_MODEL=gpt-4o

# Gemini API (required by AI engine)
GEMINI_API_KEY=

# Firebase Service Account (required for backend auth)
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/serviceAccount.json

# CORS Origins (comma-separated; default allows localhost:3000)
ALLOWED_ORIGINS=http://localhost:3000

# AI Engine Settings
MARQO_URL=http://localhost:8882
MARQO_INDEX_NAME=chic-finder-index
VECTOR_DB_PATH=data/faiss_index
IMAGE_DB_PATH=data/images

# Model Paths
SEGMENTER_MODEL_PATH=models/segmenter_vit_b.pth
ENCODER_MODEL_PATH=models/fashion_encoder_vgg16.pth
CLIP_MODEL_PATH=models/fine_tuned_clip
